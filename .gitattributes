# The skills.sh distribution files are generated LF-only and compared
# byte-for-byte by test/core/templates/skillssh-parity.test.ts. Force LF on
# checkout so Windows autocrlf doesn't turn them into CRLF and fail parity.
skills/** text eol=lf

# Real files released OpenSpec versions wrote, kept byte for byte: tests add
# their own CRLF variants, so Windows autocrlf must not convert them first.
test/fixtures/released-output/** -text

# Generated by scripts/capture-released-fingerprints.mjs; folded in GitHub diffs.
src/core/shared/released-generated-fingerprints.ts linguist-generated=true
test/fixtures/released-output/** linguist-generated=true
